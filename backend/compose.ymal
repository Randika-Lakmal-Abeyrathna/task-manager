services:
  postgres:
    image: 'postgres:latest'
    environment:
      - 'POSTGRES_DB=$DATABASE'
      - 'POSTGRES_PASSWORD=$DB_PASSWORD'
      - 'POSTGRES_USER=$DB_USER'
    ports:
      - '5432:5432'
  rabbitmq:
    image: 'rabbitmq:latest'
    environment:
      - 'RABBITMQ_DEFAULT_PASS=$RABBIT_PASSWORD'
      - 'RABBITMQ_DEFAULT_USER=$RABBIT_USER'
    ports:
      - '5672:5672'